{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run prepare:assets && vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.mts",
    "prepare:assets": "node ../scripts/sync-assets.mjs && node ../scripts/export-catalog.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^20.19.43",
    "eslint": "^10.6.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.4",
    "svelte": "^4.2.18",
    "svelte-check": "^3.8.5",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.3",
    "idb-keyval": "^6.2.6",
    "zustand": "^5.0.14"
  }
}
